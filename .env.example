# n8n 基本設定
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
# ローカル HTTP 利用時は false（HTTPS 本番では true 推奨）
N8N_SECURE_COOKIE=false
GENERIC_TIMEZONE=Asia/Tokyo
TZ=Asia/Tokyo

# Execute Command / Code ノード用（必須）
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true
N8N_BLOCK_ENV_ACCESS_IN_NODE=false

# Execute Command ノードを有効化（セルフホストのみ）
NODES_EXCLUDE=[]

# 開発時: true にすると X API の代わりに mock データを使用
USE_MOCK_X=true

# X Cookie 認証（twitter-cli Python版）
TWITTER_AUTH_TOKEN=your_auth_token
TWITTER_CT0=your_ct0_token

# 認証情報（n8n Credentials にも登録すること）
GEMINI_API_KEY=your_gemini_api_key
QIITA_ACCESS_TOKEN=your_qiita_token_optional
SLACK_WEBHOOK_URL=your_slack_webhook_url
DISCORD_WEBHOOK_URL=your_discord_webhook_url_optional

# MCP 連携（任意）
N8N_API_KEY=your_n8n_api_key
N8N_BASE_URL=http://localhost:5678
